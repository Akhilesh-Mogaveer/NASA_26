# FireLens Frontend Environment Configuration Template
# In local development, the Vite proxy handles /api -> http://localhost:8000
# For production or direct connection:
VITE_API_URL=http://localhost:8000

# Optional: CARTO Basemap API Key
# If omitted, FireLens defaults to Esri Dark Gray Canvas & Esri Satellite (100% free, no API key required)
# VITE_CARTO_API_KEY=your_carto_api_key_here
