# FireLens Backend Environment Configuration Template
# Copy this file to .env:
# cp .env.example .env

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# NASA FIRMS API Map Key
# To obtain a free API key:
# 1. Visit: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# 2. Enter your email address and request a MAP_KEY.
# 3. Check your email for your unique 32-character hexadecimal key.
# Note: FireLens works with offline/downloaded CSV datasets even without an API key.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# CORS Allowed Origins (comma-separated if customized)
# Default allows localhost:5173 and 127.0.0.1:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
